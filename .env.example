# Optional server-side AI configuration. Never commit the real .env or API key.
# No API key means a clearly labelled deterministic local mode.
# server.py reads AI_* variables from .env automatically.
# Existing environment variables take precedence.
# Set AI_MODE=local to disable remote AI even when a key is configured.
AI_MODE=auto
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30

# Speech recognition for assistant attachments
AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
